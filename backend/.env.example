# Environment Configuration & Secret Template for VIDYA-X AI (Step 16)
# Copy this file to .env or backend/.env and replace placeholders with real values.

# ---------------------------------------------------------------------------
# Application Server
# ---------------------------------------------------------------------------
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed frontend origins for CORS.
# In local dev: http://localhost:3000,http://localhost:8000
# In production: https://vidya-x.vercel.app,https://your-domain.com
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Database & Vector Store (PostgreSQL with pgvector)
# ---------------------------------------------------------------------------
# PostgreSQL connection string with psycopg driver:
# Example for Neon/Supabase:
# DATABASE_URL=postgresql+psycopg://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/vidya_x

# ---------------------------------------------------------------------------
# Storage Paths & Limits
# ---------------------------------------------------------------------------
UPLOAD_DIR=backend/uploads
VISUAL_ASSETS_DIR=backend/visual_assets
EXTRACTED_DIR=backend/extracted
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# AI & Embedding Providers
# ---------------------------------------------------------------------------
# Options for EMBEDDING_PROVIDER:
#   - local (normalized deterministic character n-gram projections, no downloads/API keys needed)
#   - sentence-transformers (requires pip install sentence-transformers, model: all-MiniLM-L6-v2)
#   - openai (requires OPENAI_API_KEY)
#   - gemini (requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Google Gemini API key for live multimodal vision analysis & conversational tutor
# Leave blank to use deterministic offline fallback generators
# GEMINI_API_KEY=your_gemini_api_key_here
VISION_MODEL=gemini-1.5-flash
LLM_MODEL=gemini-1.5-flash

# Speech-to-Text Whisper Model for Video Processing
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# ---------------------------------------------------------------------------
# Demo Mode
# ---------------------------------------------------------------------------
# Set to true to enable the 1-click Classical Mechanics sample presentation mode
DEMO_MODE_ENABLED=true
